# =============================================================================
# ANTIGRAVITY BANKING ASSISTANT CONFIGURATION
# =============================================================================

# Groq LLM API Key (Primary: ultra-fast inference with Llama 3.3 70B & Llama 3.1 8B)
GROQ_API_KEY=

# Google Gemini API Key (Secondary LLM engine)
GEMINI_API_KEY=

# Hindsight Cloud API Key (Optional: dual-mode client uses local in-memory store if omitted)
HINDSIGHT_API_KEY=
HINDSIGHT_ENDPOINT=https://api.hindsight.vectorize.io
HINDSIGHT_AGENT_BANK_ID=My AI Assistent

# Voice API Keys (Optional: browser Web Speech API provides zero-cost native mic/speaker out of the box)
SARVAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Server Configuration
PORT=8000
HOST=127.0.0.1
