# ==============================================================================
# Haq Saathi - Configuration & Environment Variables
# NOTE: Zero paid accounts or API keys required to run full offline demo!
# The built-in deterministic Indic offline engine handles 100% of spoken replies.
# ==============================================================================

# LLM Provider Selection: "offline" (default), "groq", "anthropic", or "openai"
LLM_PROVIDER=offline

# Optional Groq API Key (for Llama 3.3 70B Versatile)
GROQ_API_KEY=

# Optional Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Optional OpenAI API Key
OPENAI_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Optional Twilio Webhook Integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
